{
  "name": "@lioneltay/component-shot",
  "version": "0.1.0",
  "description": "Capture, inspect, and iterate React component scenarios with Playwright.",
  "license": "MIT",
  "author": "Lionel Tay",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "component-shot": "dist/cli.js",
    "component-shot-mcp": "dist/mcp.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./gallery": {
      "types": "./dist/gallery.d.ts",
      "default": "./dist/gallery.js"
    },
    "./mcp": {
      "types": "./dist/mcp-server.d.ts",
      "default": "./dist/mcp-server.js"
    },
    "./react": {
      "types": "./dist/runtime/types.d.ts",
      "default": "./dist/runtime/types.js"
    },
    "./rspack": {
      "types": "./dist/rspack.d.ts",
      "default": "./dist/rspack.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "docs",
    "skill",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lioneltay/component-shot.git"
  },
  "bugs": {
    "url": "https://github.com/lioneltay/component-shot/issues"
  },
  "homepage": "https://github.com/lioneltay/component-shot#readme",
  "keywords": [
    "component",
    "screenshot",
    "playwright",
    "visual-testing",
    "react",
    "mcp",
    "codex"
  ],
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "browsers": "playwright install chromium",
    "build": "tsc -p tsconfig.json && node dist/build-gallery-client.js",
    "check": "tsc -p tsconfig.json --noEmit",
    "prepare": "pnpm build",
    "prepublishOnly": "pnpm verify",
    "release:dry-run": "pnpm verify && npm pack --dry-run --ignore-scripts",
    "release:publish": "npm publish --access public",
    "test": "pnpm build && node --test --test-concurrency=1 test/*.test.mjs",
    "test:package": "node test/package-smoke.mjs",
    "verify": "pnpm test && pnpm test:package && pnpm --dir demo build"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.29.0",
    "@rspack/core": "2.0.5",
    "buffer": "6.0.3",
    "playwright": "1.56.1",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@types/node": "24.10.4",
    "@types/react": "18.0.17",
    "@types/react-dom": "18.0.6",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "typescript": "6.0.3"
  },
  "peerDependencies": {
    "react": ">=18",
    "react-dom": ">=18"
  },
  "packageManager": "pnpm@10.26.1"
}
