{
  "name": "component-shot-demo",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json && vite build",
    "browsers": "playwright install chromium",
    "dev": "vite --host 127.0.0.1",
    "gallery": "component-shot gallery",
    "preview": "vite preview --host 127.0.0.1",
    "shot": "component-shot --scenario component-shot/scenarios/product-card.tsx --save --json",
    "shot:chrome": "component-shot --scenario component-shot/scenarios/product-card.tsx --save --json --browser-channel chrome"
  },
  "dependencies": {
    "@lioneltay/component-shot": "link:..",
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "devDependencies": {
    "@types/react": "18.0.17",
    "@types/react-dom": "18.0.6",
    "@types/scheduler": "0.16.8",
    "playwright": "1.56.1",
    "typescript": "6.0.3",
    "vite": "7.2.7"
  },
  "packageManager": "pnpm@10.26.1"
}
